<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <StartupObject>Chagok.Windows.EntryPoint</StartupObject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Chagok</AssemblyName>
    <RootNamespace>Chagok.Windows</RootNamespace>
    <Version>0.10.1</Version>
    <Product>차곡</Product>
    <Title>차곡</Title>
    <Authors>ksyrang</Authors>
    <Description>폴더별 규칙으로 파일을 정리하는 도구</Description>
    <ApplicationIcon>Assets/chagok.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Chagok.Terminal/*.cs" Exclude="../Chagok.Terminal/._*.cs" Link="Terminal/%(Filename)%(Extension)" />
    <Resource Include="Assets/chagok.png" />
    <Resource Include="Assets/chagok.ico" />
    <EmbeddedResource Include="Assets/Shell/AppxManifest.xml" LogicalName="Chagok.Shell.AppxManifest.xml" />
    <EmbeddedResource Include="Assets/Shell/Chagok.ShellExtension.dll" LogicalName="Chagok.Shell.Chagok.ShellExtension.dll" />
    <EmbeddedResource Include="Assets/Shell/ShellExtension-LICENSES.txt" LogicalName="Chagok.Shell.ShellExtension-LICENSES.txt" />
    <EmbeddedResource Include="Assets/Shell/Assets/StoreLogo.png" LogicalName="Chagok.Shell.Assets.StoreLogo.png" />
    <EmbeddedResource Include="Assets/Shell/Assets/Square150x150Logo.png" LogicalName="Chagok.Shell.Assets.Square150x150Logo.png" />
    <EmbeddedResource Include="Assets/Shell/Assets/Square44x44Logo.png" LogicalName="Chagok.Shell.Assets.Square44x44Logo.png" />
    <ProjectReference Include="../Chagok.Core/Chagok.Core.csproj" />
    <PackageReference Include="System.Management" Version="10.0.9" />
  </ItemGroup>
</Project>
